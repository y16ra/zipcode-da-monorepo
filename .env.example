# --- Backend / Japan Post API ---
# 本番: https://api.da.pf.japanpost.jp  スタブ等はドキュメントのURLに合わせて変更
JAPANPOST_API_BASE_URL=https://api.da.pf.japanpost.jp
# トークン取得のパス（既定: /api/v2/j/token）。リクエストサンプルは POST /api/v2/j/token。古い環境のみ /api/v1/j/token の場合あり
# JAPANPOST_TOKEN_PATH=/api/v1/j/token
# コード番号検索のパス接頭辞（既定: /api/v2/searchcode → GET .../api/v2/searchcode/{code}）。v1 のみの環境は /api/v1/searchcode
# JAPANPOST_SEARCH_CODE_PATH=/api/v1/searchcode
JAPANPOST_CLIENT_ID=
JAPANPOST_SECRET_KEY=
# トークン取得・検索時に付与する X-Forwarded-For（API要件。クライアントIPの代用可）
JAPANPOST_X_FORWARDED_FOR=127.0.0.1
# 任意: プロバイダーユーザーID（searchcode の ec_uid）
# JAPANPOST_EC_UID=
# 任意: トークンリクエスト JSON に scope を付ける（契約・環境によっては J1 等が必要な場合あり）
# JAPANPOST_TOKEN_SCOPE=J1

HTTP_ADDR=:8080
BACKEND_PORT=8080
# ブラウザからバックエンドへアクセスする際の CORS（本番では具体オリジンを推奨）
CORS_ALLOW_ORIGIN=*

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
FRONTEND_PORT=3000
